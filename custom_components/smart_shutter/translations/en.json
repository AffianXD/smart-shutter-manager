      "custom_schedules_menu": {
        "title": "Custom schedules",
        "description": "Recurring time exceptions, defined once and applied to all shutters (can still be overridden locally per shutter). List order = priority on overlap - the first matching rule wins.",
        "data": {
          "choice": "Select rule"
        }
      },
      "custom_schedule_actions": {
        "title": "{name} (priority {position}/{total})",
        "description": "What would you like to do with this rule?",
        "data": {
          "action": "Action"
        }
      },
      "custom_schedule_edit": {
        "title": "Custom schedule: {name}",
        "description": "Custom schedules only support fixed times (no sunrise/sunset). Leave blank to leave that action (open/close) unaffected by this rule.",
        "data": {
          "name": "Name",
          "weekdays": "Weekdays",
          "interval_weeks": "Every how many weeks? (1 = every week)",
          "reference_date": "Reference date (starting point for week counting)",
          "end_date": "End date (optional, rule stops applying after this date)",
          "open_time": "Open time (optional)",
          "close_time": "Close time (optional)",
          "delete": "Delete this rule"
        }
      },
      "custom_schedule_conflict": {
        "title": "Overlap detected",
        "description": "The rule {name} overlaps with at least one existing rule ({conflicts}) on at least one day within the next 2 years. Which one should win on those days? You can fine-tune the exact order any time afterwards using move up/down in the list.",
        "data": {
          "priority_choice": "Priority"
        }
      },
      "external_triggers_menu": {
        "title": "External triggers",
        "description": "Named rules whose target time is set via service (smart_shutter.set_external_trigger) from an external automation - e.g. to pass an alarm-clock time to a specific shutter. An active trigger always wins over profiles/custom schedules until its time is reached - no separate priority list is needed for this.",
